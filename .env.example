# Copy this file to .env and fill in local values. .env is ignored by Git.
# Existing system environment variables take precedence over this file.
INTENTCART_DRIVER=demo
# Live mode requires a tool-calling OpenAI-compatible chat-completions provider.
# INTENTCART_DRIVER=live
# INTENTCART_API_BASE=https://api.deepseek.com
# INTENTCART_API_KEY=replace-with-your-key
# INTENTCART_MODEL=deepseek-v4-flash
# Live-mode speed/cost controls. Defaults are 6 rounds and 12 tool calls.
# INTENTCART_MAX_ROUNDS=6
# INTENTCART_MAX_TOOLS=12
# INTENTCART_DB_PATH=var/intentcart.sqlite
# Local-only research environment. No real payments or merchant integration.
